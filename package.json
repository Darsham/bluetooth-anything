{
  "name": "anyble",
  "version": "0.1.0",
  "description": "Connect and control any Bluetooth LE device — without the vendor's app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "anyble": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [
    "bluetooth",
    "ble",
    "gatt",
    "iot",
    "cli",
    "reverse-engineering",
    "device-control"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "@stoprocent/noble": "^2.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
